{
  "name": "@gracefullight/krds-root",
  "version": "0.0.0",
  "private": true,
  "homepage": "https://github.com/gracefullight/krds",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "prepare": "hk install",
    "publish-packages": "turbo run build --filter=./packages/* && changeset version && changeset publish",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "test": "vitest",
    "test:ci": "vitest run",
    "version": "changeset version && bun install --ignore-scripts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@turbo/gen": "^2.11.11",
    "@types/node": "^26.6.6",
    "axios": "^1.21.1",
    "devmoji": "^2.3.0",
    "es-toolkit": "^1.53.2",
    "turbo": "^2.11.11",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
